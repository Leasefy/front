# Arriendo Facil - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Database (Neon) - Phase 1
# =============================================================================
DATABASE_URL="postgresql://user:password@host.neon.tech/arriendo_facil?sslmode=require"

# =============================================================================
# Authentication (Supabase) - Phase 2
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# =============================================================================
# Backend API
# =============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# =============================================================================
# File Upload (UploadThing) - Phase 4
# =============================================================================
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# =============================================================================
# Background Jobs (Inngest) - Phase 6
# =============================================================================
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# =============================================================================
# Interactive Map (Mapbox) - Phase 9
# =============================================================================
# Get your token from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# =============================================================================
# AI API Configuration - Phase 24
# =============================================================================
# Set to "false" to use real backend API instead of mock data
NEXT_PUBLIC_USE_MOCK_API=true
# Backend URL for AI orchestrator (only used when mock is disabled)
NEXT_PUBLIC_AI_API_URL=/api/v1/ai
# Delay in ms for mock responses (adjust for testing UX)
NEXT_PUBLIC_MOCK_DELAY_MS=800

# =============================================================================
# AI Agents (Mastra) - Sandbox
# =============================================================================
ANTHROPIC_API_KEY=""

# =============================================================================
# Avalúo — informe web (/avaluo/reporte/[slug]?token=), LA entrega del avalúo
# =============================================================================
# Siempre encendida (no hay bandera): es el entregable principal; el PDF es la
# descarga secundaria. Sin `?token=` válido del dueño responde 404.
# Base del microservicio de avalúo para el cliente. Vacío ⇒ mismo origen.
# NEXT_PUBLIC_AVALUO_API_URL=""
# Base del micro para el fetch SERVER-SIDE del informe (`GET /api/avaluo/report/
# [slug]?token=`). Sin prefijo NEXT_PUBLIC_: sólo la lee el servidor. Un fetch
# desde el servidor necesita URL absoluta, así que acá el «vacío ⇒ mismo origen»
# NO aplica: vacía o ausente ⇒ se intenta NEXT_PUBLIC_AVALUO_API_URL, y si esa
# también está vacía la landing responde 404 a todo. 🔴 OBLIGATORIA en producción.
# AVALUO_API_URL="https://app.avaluonest.co"

# =============================================================================
# Application Settings
# =============================================================================
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
