# Arriendo Facil - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Database (Neon) - Phase 1
# =============================================================================
DATABASE_URL="postgresql://user:password@host.neon.tech/arriendo_facil?sslmode=require"

# =============================================================================
# Authentication (Supabase) - Phase 2
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# =============================================================================
# Backend API
# =============================================================================
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# =============================================================================
# File Upload (UploadThing) - Phase 4
# =============================================================================
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# =============================================================================
# Background Jobs (Inngest) - Phase 6
# =============================================================================
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# =============================================================================
# Interactive Map (Mapbox) - Phase 9
# =============================================================================
# Get your token from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""

# =============================================================================
# AI API Configuration - Phase 24
# =============================================================================
# Set to "false" to use real backend API instead of mock data
NEXT_PUBLIC_USE_MOCK_API=true
# Backend URL for AI orchestrator (only used when mock is disabled)
NEXT_PUBLIC_AI_API_URL=/api/v1/ai
# Delay in ms for mock responses (adjust for testing UX)
NEXT_PUBLIC_MOCK_DELAY_MS=800

# =============================================================================
# AI Agents (Mastra) - Sandbox
# =============================================================================
ANTHROPIC_API_KEY=""

# =============================================================================
# Application Settings
# =============================================================================
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------
# Cierre de sesion por inactividad
# --------------------------------------------
# Minutos sin actividad del usuario antes de cerrar la sesion. 0/vacio = apagado.
# La cuenta se corre con acciones reales (click, tecla, scroll, touch), NO con
# el polling de las pantallas: mousemove esta excluido a proposito.
# A los 60 segundos del tope aparece un aviso con cuenta regresiva y un boton
# "Continuar". Si el contador llega a 0 se revoca la sesion en el backend
# (POST /auth/session/revoke) y recien ahi se vuelve al login.
# La marca de actividad se comparte entre pestanas via localStorage.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=0
