# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — denegar por defecto.
#
# Antes eran cinco patrones concretos y cualquier variante quedaba afuera:
# un `.env.local.bak-3000` vivía sin ignorar, a un `git add -A` de entrar en
# la historia del repo. Con secretos el criterio va al revés: se ignora TODO
# lo que empiece por `.env`, y `.env.example` es la excepción explícita.
.env
.env.*

# Keep .env.example tracked for documentation
!.env.example

# Copias de seguridad hechas a mano: casi siempre de un archivo de config, y
# por eso casi siempre con credenciales adentro.
*.bak
*.bak-*
*.backup

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright MCP scratch output
.playwright-mcp/

# Loose screenshots / design-iteration captures in the repo root.
# App assets belong in public/ (served by Next); root images are never served.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.avif

# Volcado de Redis local (aparece al correr redis-server desde la raíz del repo).
dump.rdb
