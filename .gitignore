# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep .env.example tracked for documentation
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Playwright MCP scratch output
.playwright-mcp/

# Loose screenshots / design-iteration captures in the repo root.
# App assets belong in public/ (served by Next); root images are never served.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.avif

# Volcado de Redis local (aparece al correr redis-server desde la raíz del repo).
dump.rdb
